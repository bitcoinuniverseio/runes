---
interface Props {
  type?: 'note' | 'warning' | 'burn' | 'invariant';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const defaultTitles = {
  note: 'Note',
  warning: 'Warning',
  burn: 'Burn Risk · Cenotaph Condition',
  invariant: 'Protocol Invariant'
};

const displayTitle = title || defaultTitles[type];
const calloutClass = `callout callout-${type}`;
---

<aside class={calloutClass}>
  <div class="callout-title">
    {type === 'burn' && (
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
    )}
    {type === 'warning' && (
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    )}
    {type === 'invariant' && (
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    )}
    {type === 'note' && (
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
    )}
    <span>{displayTitle}</span>
  </div>
  <div class="callout-body">
    <slot />
  </div>
</aside>
