---
import flawsData from '../data/protocol/flaws.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="table-scroll">
  <table>
    <caption>Complete flaw list as reported by ord 0.29.0</caption>
    <thead>
      <tr>
        <th scope="col">Flaw Name</th>
        <th scope="col">Trigger Condition</th>
        <th scope="col">Controlling Rule</th>
        <th scope="col">Reference Source</th>
      </tr>
    </thead>
    <tbody>
      {flawsData.map((f) => (
        <tr>
          <td><code>{f.flaw}</code></td>
          <td>{f.condition}</td>
          <td>
            <a href={`${base}/specification.html#${f.rule.toLowerCase()}`}>{f.rule}</a>
          </td>
          <td>
            <span style="font-family: var(--font-mono); font-size: 0.75rem;">{f.ordSource}</span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
