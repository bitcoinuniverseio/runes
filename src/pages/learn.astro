---
import BaseLayout from '../layouts/BaseLayout.astro';
import tracksData from '../data/courses/tracks.json';
import FeedbackWidget from '../components/FeedbackWidget.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const toc = [
  { id: 'curriculum', text: 'Curriculum Tracks' },
  { id: 'progress', text: 'Local Learning Progress' },
  { id: 'methodology', text: 'Educational Methodology' },
];
---

<BaseLayout
  title="Runes Learning Academy"
  description="Structured curriculum for developers, node operators, wallet architects, and Bitcoin protocol enthusiasts."
  currentRoute="learn.html"
  kicker="Interactive Curriculum"
  toc={toc}
>
  <div class="status-line">
    7 specialized curriculum tracks · Interactive quizzes · Local private progress tracking.
  </div>

  <p class="lede">
    Welcome to the Runes Learning Academy. Each track provides concise, technical lessons followed by consensus verification quizzes linked directly to the normative specification rules.
  </p>

  <h2 id="curriculum">Curriculum Tracks</h2>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
    {tracksData.map((t) => (
      <article style="border: 1px solid var(--border); background: var(--bg-card); padding: 1.5rem; border-radius: var(--radius-sm); display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
            <span style="font-family: var(--font-sans); font-size: 0.75rem; text-transform: uppercase; color: var(--text-faint); font-weight: 700;">
              Track {t.order}
            </span>
            <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">
              ~{t.estimatedMinutes} min
            </span>
          </div>

          <h3 style="margin-top: 0; margin-bottom: 0.5rem; font-size: 1.2rem;">
            <a href={`${base}/learn/${t.slug}.html`} style="color: var(--text); text-decoration: none;">
              {t.title}
            </a>
          </h3>

          <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1rem;">
            <strong>Audience:</strong> {t.audience}
          </p>

          <p style="font-size: 0.875rem; margin-bottom: 1.25rem;">
            {t.outcomes}
          </p>
        </div>

        <a href={`${base}/learn/${t.slug}.html`} class="btn-primary" style="text-align: center; text-decoration: none; font-size: 0.8125rem;">
          Start Track {t.order} →
        </a>
      </article>
    ))}
  </div>

  <h2 id="progress">Local Learning Progress</h2>
  <div class="callout callout-note">
    <div class="callout-title">Private & Client-Side Storage</div>
    <p>
      Your quiz results and completed lesson marks are stored strictly in your browser's local storage (<code>localStorage</code>). No user accounts, cookies, analytics, or external trackers are utilized.
    </p>
    <div style="margin-top: 1rem;">
      <button type="button" id="reset-progress-btn" class="page-action-btn" style="border-color: var(--burn-border); color: var(--burn-red);">
        Reset All Academy Progress
      </button>
    </div>
  </div>

  <h2 id="methodology">Educational Methodology</h2>
  <p>
    Every lesson in this curriculum is grounded directly in Casey Rodarmor's <code>ord</code> 0.29.0 reference source code. You will never encounter marketing conjecture, vague analogies, or conflicting rules.
  </p>

  <FeedbackWidget pageTitle="Runes Learning Academy" />

  <script is:inline>
    var resetBtn = document.getElementById('reset-progress-btn');
    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        if (confirm('Are you sure you want to reset all saved lesson completions?')) {
          localStorage.removeItem('runes-academy-progress');
          alert('Progress has been reset.');
          window.location.reload();
        }
      });
    }
  </script>
</BaseLayout>
